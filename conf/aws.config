/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    AWS Batch configuration for OTUseq pipeline
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Configuration for running the pipeline on AWS Batch
    Use with: -profile aws_batch
----------------------------------------------------------------------------------------
*/

// AWS Batch-specific settings
aws {
    region = 'us-east-1'  // Cambiar según tu región
    batch {
        cliPath = '/home/ec2-user/miniconda/bin/aws'
        maxTransferAttempts = 3
        delayBetweenAttempts = '5 sec'
    }
}

// Process executor configuration for AWS Batch
process {
    executor = 'awsbatch'
    queue = 'default'  // Cambiar al nombre de tu cola de AWS Batch

    // Error handling for AWS Batch
    errorStrategy = { task.exitStatus in [143,137,104,134,139] ? 'retry' : 'finish' }
    maxRetries = 3

    // Container settings
    container = 'public.ecr.aws/b1n7j4p9/qiime2:2023.2'

    // Resource requirements by label
    withLabel:process_single {
        cpus = 1
        memory = '6 GB'
    }

    withLabel:process_low {
        cpus = 2
        memory = '12 GB'
    }

    withLabel:process_medium {
        cpus = 4
        memory = '32 GB'
    }

    withLabel:process_high {
        cpus = 16
        memory = '120 GB'
    }

    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries = 5
    }

    // Process-specific containers
    withName:FASTQC {
        container = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0'
    }

    withName:MULTIQC {
        container = 'quay.io/biocontainers/multiqc:1.21--pyhdfd78af_0'
    }

    withName:CUTADAPT {
        container = 'quay.io/biocontainers/cutadapt:4.9--py310h1fe012e_3'
    }

    withName:REMOVE_HOMOPOLYMERS {
        container = 'community.wave.seqera.io/library/biopython_pandas:dbbdf93e473af259'
    }

    withName:EXPORT_TO_EXCEL {
        container = 'quay.io/biocontainers/mulled-v2-3a59640f3fe1ed11819984087d31d68600200c3f:185a25ca79923df85b58f42deb48f5ac4481e91f-0'
    }

    withName:TAXONOMY_PLOTS {
        container = 'quay.io/biocontainers/mulled-v2-5d3f49b113a76edda01cd831e89a1c87d7d350da:3ad8ce28b8e5f8bb86e4ce2eaf3897f80bd4a5ef-0'
    }

    withName:RAREFACTION_PLOTS {
        container = 'quay.io/biocontainers/mulled-v2-9adca5a7d3b24119897cfc20386da6c7fa47bfe9:f4117b9e9699d02fe6e873c07c1b49b0b61c6e99-0'
    }

    withName:GENERATE_REPORT {
        container = 'rocker/verse:4.4.2'
        memory = '16 GB'
        cpus = 4
    }
}

// Workdir in S3
workDir = 's3://genomamayor/work'  // Cambiar a tu bucket de S3

// Enable AWS S3 storage
aws.client.uploadChunkSize = '100MB'
aws.client.uploadMaxThreads = 8
aws.client.uploadStorageClass = 'INTELLIGENT_TIERING'
